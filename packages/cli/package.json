{
  "name": "@boomin/cli",
  "version": "0.4.0",
  "description": "Boomin CLI for setup, handoff scaffolding, tokens, scopes, smoke tests, and the Platform v1 distribution tree.",
  "type": "module",
  "bin": {
    "boomin": "src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boomin-Ai/sdk.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./cli": {
      "import": "./src/cli.js",
      "default": "./src/cli.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node --check src/cli.js && node --check src/v1.js && node --check src/errors.js",
    "test": "node --test 'test/*.test.js'",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "boomin",
    "cli",
    "partner-connect",
    "platform-api",
    "agents"
  ],
  "author": "Boomin",
  "license": "MIT",
  "dependencies": {
    "@boomin/sdk": "^1.0.0-beta.2"
  }
}
